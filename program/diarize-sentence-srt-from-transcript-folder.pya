exists su name prefix ob text "auto" be default ya
exists su name voices_dir ob text "" be default ya
exists su name speaker_host ob text "http://127.0.0.1:8010" be default ya
ob filename text transcript_dir be input ya

ob name transcript_dir to name text transcript path be text do

ob text "PYA_SPEAKER_HOST=" to name text cmd be text do
ob name text speaker_host to name cmd be plus do
ob text " PYA_COMMAND_TIMEOUT_MS=7200000 node /home/htaf/pyac/pyash/world/house/owen-sound-reporter/program/diarize-sentence-srt-from-transcript-folder.mjs \"" to name cmd be plus do
ob name text transcript path to name cmd be plus do
ob text "\" \"" to name cmd be plus do
ob name text prefix to name cmd be plus do
ob text "\" \"" to name cmd be plus do
ob name text voices_dir to name cmd be plus do
ob text "\"" to name cmd be plus do

ob text of ob of cmd to name text out be command do
ob name out be write do
